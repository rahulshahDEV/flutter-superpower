+import 'package:flutter_bloc/flutter_bloc.dart';
+
+abstract class SafeCubit<S> extends Cubit<S> {
+  SafeCubit(super.initialState);
+  void safeEmit(S next) {
+    if (!isClosed) emit(next);
+  }
+}
