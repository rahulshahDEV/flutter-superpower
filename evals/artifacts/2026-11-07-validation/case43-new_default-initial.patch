+import 'package:stack_eval/core/state/safe_cubit.dart';
+
+import 'package:stack_eval/features/orders/domain/orders_repository.dart';
+import 'package:stack_eval/features/orders/presentation/cubit/orders/orders_state.dart';
+import 'package:stack_eval/features/orders/presentation/orders_text.dart';
+
+class OrdersCubit extends SafeCubit<OrdersState> {
+  OrdersCubit(this.repository, this.accountId) : super(const OrdersInitial());
+  final OrdersRepository repository;
+  final String accountId;
+  int _generation = 0;
+  Future<void> load() async {
+    if (isClosed) return;
+    final request = ++_generation;
+    final retained = state.items;
+    safeEmit(OrdersLoading(retained));
+    await _fetch(request, retained);
+  }
+
+  Future<void> _fetch(int request, List<Order> retained) async {
+    OrdersResult result;
+    try {
+      result = await repository.fetch(accountId);
+    } catch (_) {
+      // The contract normally returns safe failures; never expose thrown internals.
+      result = const OrdersFailure(OrdersText.unexpectedFailure);
+    }
+    if (isClosed || request != _generation) return;
+    switch (result) {
+      case OrdersSuccess(:final items):
+        safeEmit(OrdersLoaded(items));
+      case OrdersFailure(:final message):
+        safeEmit(OrdersFailed(message, retained));
+    }
+  }
+}
