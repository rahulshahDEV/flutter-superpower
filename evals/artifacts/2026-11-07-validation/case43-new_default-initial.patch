+import 'package:flutter/material.dart';
+
+import 'package:stack_eval/features/orders/presentation/cubit/orders/orders_state.dart';
+import 'package:stack_eval/features/orders/presentation/orders_text.dart';
+
+class OrdersContent extends StatelessWidget {
+  const OrdersContent({required this.state, required this.retry, super.key});
+  final OrdersState state;
+  final VoidCallback retry;
+  @override
+  Widget build(BuildContext context) => SafeArea(
+    child: Column(
+      children: [
+        if (state is OrdersLoading) const Text(OrdersText.loading),
+        if (state case OrdersFailed(:final message)) Text(message),
+        if (state is OrdersLoaded && state.items.isEmpty)
+          const Text(OrdersText.empty),
+        Expanded(
+          child: ListView.builder(
+            itemCount: state.items.length,
+            itemBuilder: (context, index) =>
+                ListTile(title: Text(state.items[index].id)),
+          ),
+        ),
+        TextButton(onPressed: retry, child: const Text(OrdersText.retry)),
+      ],
+    ),
+  );
+}
