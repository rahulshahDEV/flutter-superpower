+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import 'package:stack_eval/features/orders/domain/orders_repository.dart';
+import 'package:stack_eval/features/orders/presentation/providers/orders_providers.dart';
+import 'package:stack_eval/features/orders/presentation/widgets/orders_view_widget.dart';
+
+final class OrdersRoute extends StatelessWidget {
+  const OrdersRoute({
+    required this.repository,
+    required this.accountId,
+    super.key,
+  });
+  final OrdersRepository repository;
+  final String accountId;
+  @override
+  Widget build(BuildContext context) => _OwnedOrders(
+    key: _OrdersKey(repository, accountId),
+    repository: repository,
+    accountId: accountId,
+  );
+}
+
+/// Repository identity and account changes create a fresh route-owned scope.
+final class _OrdersKey extends LocalKey {
+  const _OrdersKey(this.repository, this.accountId);
+  final OrdersRepository repository;
+  final String accountId;
+  @override
+  bool operator ==(Object other) =>
+      other is _OrdersKey &&
+      identical(repository, other.repository) &&
+      accountId == other.accountId;
+  @override
+  int get hashCode => Object.hash(identityHashCode(repository), accountId);
+}
+
+final class _OwnedOrders extends StatelessWidget {
+  const _OwnedOrders({
+    required this.repository,
+    required this.accountId,
+    super.key,
+  });
+  final OrdersRepository repository;
+  final String accountId;
+  @override
+  Widget build(BuildContext context) => ProviderScope(
+    overrides: [
+      ordersRepositoryProvider.overrideWithValue(repository),
+      ordersAccountProvider.overrideWithValue(accountId),
+    ],
+    child: const _OrdersConsumer(),
+  );
+}
+
+final class _OrdersConsumer extends ConsumerWidget {
+  const _OrdersConsumer();
+  @override
+  Widget build(BuildContext context, WidgetRef ref) => OrdersView(
+    state: ref.watch(ordersProvider),
+    retry: ref.read(ordersProvider.notifier).refresh,
+  );
+}
