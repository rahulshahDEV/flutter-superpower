+import 'dart:async';
+
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import 'package:stack_eval/features/orders/domain/orders_repository.dart';
+import 'package:stack_eval/features/orders/presentation/providers/orders_providers.dart';
+import 'package:stack_eval/features/orders/presentation/state/orders_state.dart';
+
+final class OrdersNotifier extends Notifier<OrdersState> {
+  int _request = 0;
+  bool _disposed = false;
+  @override
+  OrdersState build() {
+    _disposed = false;
+    ref.onDispose(() {
+      _disposed = true;
+      _request++;
+    });
+    unawaited(Future.microtask(refresh));
+    return OrdersState(loading: true);
+  }
+
+  void _publish(OrdersState value) => state = value;
+  Future<void> refresh() async {
+    if (_disposed) return;
+    final repository = ref.read(ordersRepositoryProvider);
+    final accountId = ref.read(ordersAccountProvider);
+    final request = ++_request;
+    _publish(
+      OrdersState(items: state.items, loaded: state.loaded, loading: true),
+    );
+    final result = await repository.fetch(accountId);
+    if (_disposed || request != _request) return;
+    _publish(switch (result) {
+      OrdersSuccess(:final items) => OrdersState(items: items, loaded: true),
+      OrdersFailure(:final message) => OrdersState(
+        items: state.items,
+        loaded: state.loaded,
+        message: message,
+      ),
+    });
+  }
+}
