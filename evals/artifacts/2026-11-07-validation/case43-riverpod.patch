+import 'package:flutter/material.dart';
+
+import 'package:stack_eval/features/orders/presentation/state/orders_state.dart';
+import 'package:stack_eval/features/orders/presentation/utils/orders_text.dart';
+
+final class OrdersView extends StatelessWidget {
+  const OrdersView({required this.state, required this.retry, super.key});
+  final OrdersState state;
+  final VoidCallback retry;
+  @override
+  Widget build(BuildContext context) => Column(
+    children: [
+      if (state.loading) const Text(OrdersText.loading),
+      if (state.loaded && state.items.isEmpty) const Text(OrdersText.empty),
+      if (state.message case final message?) Text(message),
+      Expanded(
+        child: ListView.builder(
+          itemCount: state.items.length,
+          itemBuilder: (context, index) =>
+              ListTile(title: Text(state.items[index].id)),
+        ),
+      ),
+      TextButton(onPressed: retry, child: const Text(OrdersText.retry)),
+    ],
+  );
+}
