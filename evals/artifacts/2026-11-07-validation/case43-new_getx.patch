+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+import 'package:stack_eval/features/orders/domain/orders_repository.dart';
+import 'package:stack_eval/features/orders/presentation/pages/orders_route.dart';
+
+class PendingRepository implements OrdersRepository {
+  final calls = <({String account, Completer<OrdersResult> result})>[];
+  @override
+  Future<OrdersResult> fetch(String accountId) {
+    final result = Completer<OrdersResult>();
+    calls.add((account: accountId, result: result));
+    return result.future;
+  }
+
+  void success(int request, List<String> ids) => calls[request].result.complete(
+    OrdersSuccess(ids.map(Order.new).toList()),
+  );
+  void failure(int request, String message) =>
+      calls[request].result.complete(OrdersFailure(message));
+}
+
+Widget app(PendingRepository repo, {String account = 'a'}) => MaterialApp(
+  home: Scaffold(
+    body: OrdersRoute(
+      key: const ValueKey('route'),
+      repository: repo,
+      accountId: account,
+    ),
+  ),
+);
+Future<void> frame(WidgetTester tester) async {
+  await tester.pump();
+  await tester.pump();
+}
+
+void main() {
+  testWidgets('initializes once; failure retries into empty and content', (
+    tester,
+  ) async {
+    final repo = PendingRepository();
+    await tester.pumpWidget(app(repo));
+    expect(find.text('Loading'), findsOneWidget);
+    expect(repo.calls.length, 1);
+    await tester.pumpWidget(app(repo));
+    expect(repo.calls.length, 1);
+    repo.failure(0, 'Safe message');
+    await frame(tester);
+    expect(find.text('Safe message'), findsOneWidget);
+    await tester.tap(find.text('Retry'));
+    await frame(tester);
+    repo.success(1, []);
+    await frame(tester);
+    expect(find.text('No orders'), findsOneWidget);
+    await tester.tap(find.text('Retry'));
+    await frame(tester);
+    repo.success(2, ['order-17']);
+    await frame(tester);
+    expect(find.text('order-17'), findsOneWidget);
+    expect(find.text('No orders'), findsNothing);
+  });
+  testWidgets('refresh retains content and latest request alone publishes', (
+    tester,
+  ) async {
+    final repo = PendingRepository();
+    await tester.pumpWidget(app(repo));
+    repo.success(0, ['kept']);
+    await frame(tester);
+    await tester.tap(find.text('Retry'));
+    await frame(tester);
+    expect(find.text('Loading'), findsOneWidget);
+    expect(find.text('kept'), findsOneWidget);
+    await tester.tap(find.text('Retry'));
+    await frame(tester);
+    repo.failure(2, 'Refresh failed');
+    await frame(tester);
+    expect(find.text('kept'), findsOneWidget);
+    expect(find.text('Refresh failed'), findsOneWidget);
+    repo.success(1, ['obsolete']);
+    await frame(tester);
+    expect(find.text('obsolete'), findsNothing);
+    expect(find.text('Refresh failed'), findsOneWidget);
+    await tester.tap(find.text('Retry'));
+    await frame(tester);
+    await tester.tap(find.text('Retry'));
+    await frame(tester);
+    repo.success(4, ['newest']);
+    await frame(tester);
+    repo.failure(3, 'Obsolete error');
+    await frame(tester);
+    expect(find.text('newest'), findsOneWidget);
+    expect(find.text('Obsolete error'), findsNothing);
+  });
+  testWidgets('same-key account replacement resets data and pending results', (
+    tester,
+  ) async {
+    final repo = PendingRepository();
+    await tester.pumpWidget(app(repo));
+    repo.success(0, ['private-a']);
+    await frame(tester);
+    await tester.tap(find.text('Retry'));
+    await frame(tester);
+    await tester.pumpWidget(app(repo, account: 'b'));
+    await frame(tester);
+    expect(repo.calls.map((call) => call.account), ['a', 'a', 'b']);
+    expect(find.text('private-a'), findsNothing);
+    expect(find.text('Loading'), findsOneWidget);
+    repo.success(1, ['late-a']);
+    await frame(tester);
+    expect(find.text('late-a'), findsNothing);
+    repo.success(2, ['private-b']);
+    await frame(tester);
+    expect(find.text('private-b'), findsOneWidget);
+  });
+  testWidgets('same-key repository replacement rejects old completion', (
+    tester,
+  ) async {
+    final old = PendingRepository();
+    final replacement = PendingRepository();
+    await tester.pumpWidget(app(old));
+    await tester.pumpWidget(app(replacement));
+    await frame(tester);
+    expect(replacement.calls.length, 1);
+    old.failure(0, 'Old repository');
+    await frame(tester);
+    expect(find.text('Old repository'), findsNothing);
+    replacement.success(0, ['replacement']);
+    await frame(tester);
+    expect(find.text('replacement'), findsOneWidget);
+  });
+  testWidgets(
+    'leaving and reopening creates fresh state; borrowed repo remains usable',
+    (tester) async {
+      final repo = PendingRepository();
+      await tester.pumpWidget(app(repo));
+      await tester.pumpWidget(const SizedBox());
+      await frame(tester);
+      repo.success(0, ['abandoned']);
+      await frame(tester);
+      expect(tester.takeException(), isNull);
+      await tester.pumpWidget(app(repo));
+      await frame(tester);
+      expect(repo.calls.length, 2);
+      expect(find.text('abandoned'), findsNothing);
+      repo.success(1, ['reopened']);
+      await frame(tester);
+      expect(find.text('reopened'), findsOneWidget);
+    },
+  );
+  testWidgets('two mounted routes have independent owner and lifecycle', (
+    tester,
+  ) async {
+    final repo = PendingRepository();
+    Widget pair(bool first) => MaterialApp(
+      home: Scaffold(
+        body: Row(
+          children: [
+            if (first)
+              Expanded(
+                key: const ValueKey('first-slot'),
+                child: OrdersRoute(
+                  key: const ValueKey('first'),
+                  repository: repo,
+                  accountId: 'a',
+                ),
+              ),
+            Expanded(
+              key: const ValueKey('second-slot'),
+              child: OrdersRoute(
+                key: const ValueKey('second'),
+                repository: repo,
+                accountId: 'b',
+              ),
+            ),
+          ],
+        ),
+      ),
+    );
+    await tester.pumpWidget(pair(true));
+    await frame(tester);
+    expect(repo.calls.map((call) => call.account), ['a', 'b']);
+    repo.success(0, ['first-order']);
+    repo.success(1, ['second-order']);
+    await frame(tester);
+    expect(find.text('first-order'), findsOneWidget);
+    expect(find.text('second-order'), findsOneWidget);
+    await tester.pumpWidget(pair(false));
+    await frame(tester);
+    expect(repo.calls.length, 2);
+    expect(find.text('second-order'), findsOneWidget);
+    await tester.tap(find.text('Retry'));
+    await frame(tester);
+    expect(repo.calls.last.account, 'b');
+    repo.success(2, ['second-refreshed']);
+    await frame(tester);
+    expect(find.text('second-refreshed'), findsOneWidget);
+  });
+  testWidgets('thrown internals use safe recovery text', (tester) async {
+    final repo = PendingRepository();
+    await tester.pumpWidget(app(repo));
+    repo.calls[0].result.completeError(StateError('secret-token'));
+    await frame(tester);
+    expect(
+      find.text('Unable to load orders. Please try again.'),
+      findsOneWidget,
+    );
+    expect(find.textContaining('secret-token'), findsNothing);
+  });
+  testWidgets('narrow layout supports large text and long failure', (
+    tester,
+  ) async {
+    tester.view.physicalSize = const Size(320, 640);
+    tester.view.devicePixelRatio = 1;
+    addTearDown(tester.view.resetPhysicalSize);
+    addTearDown(tester.view.resetDevicePixelRatio);
+    final repo = PendingRepository();
+    await tester.pumpWidget(
+      MaterialApp(
+        home: MediaQuery(
+          data: const MediaQueryData(textScaler: TextScaler.linear(2)),
+          child: Scaffold(
+            body: OrdersRoute(repository: repo, accountId: 'a'),
+          ),
+        ),
+      ),
+    );
+    repo.failure(
+      0,
+      'Please check your connection and try loading your order history again.',
+    );
+    await frame(tester);
+    expect(find.text('Retry'), findsOneWidget);
+    expect(tester.takeException(), isNull);
+  });
+}
