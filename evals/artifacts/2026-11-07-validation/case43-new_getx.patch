+import 'package:flutter/material.dart';
+import 'package:get/get.dart';
+
+import 'package:stack_eval/features/orders/presentation/bindings/orders_binding.dart';
+
+import 'package:stack_eval/features/orders/domain/orders_repository.dart';
+import 'package:stack_eval/features/orders/presentation/controllers/orders_controller.dart';
+import 'package:stack_eval/features/orders/presentation/widgets/orders_content.dart';
+
+class OrdersRoute extends StatefulWidget {
+  const OrdersRoute({
+    required this.repository,
+    required this.accountId,
+    super.key,
+  });
+  final OrdersRepository repository;
+  final String accountId;
+  @override
+  State<OrdersRoute> createState() => _OrdersRouteState();
+}
+
+class _OrdersRouteState extends State<OrdersRoute> {
+  Key _ownerKey = UniqueKey();
+  @override
+  void didUpdateWidget(OrdersRoute oldWidget) {
+    super.didUpdateWidget(oldWidget);
+    if (!identical(oldWidget.repository, widget.repository) ||
+        oldWidget.accountId != widget.accountId) {
+      _ownerKey = UniqueKey();
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) => _OrdersOwner(
+    key: _ownerKey,
+    repository: widget.repository,
+    accountId: widget.accountId,
+  );
+}
+
+class _OrdersOwner extends StatefulWidget {
+  const _OrdersOwner({
+    required this.repository,
+    required this.accountId,
+    super.key,
+  });
+  final OrdersRepository repository;
+  final String accountId;
+  @override
+  State<_OrdersOwner> createState() => _OrdersOwnerState();
+}
+
+class _OrdersOwnerState extends State<_OrdersOwner> {
+  late final OrdersController _owner;
+  @override
+  void initState() {
+    super.initState();
+    _owner = OrdersBinding.create(widget.repository, widget.accountId);
+  }
+
+  @override
+  void dispose() {
+    OrdersBinding.dispose(_owner);
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Obx(() => OrdersContent(state: _owner.state, retry: _owner.load));
+  }
+}
