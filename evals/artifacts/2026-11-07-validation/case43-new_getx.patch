+import 'package:stack_eval/features/orders/domain/orders_repository.dart';
+import 'package:stack_eval/features/orders/presentation/controllers/orders_controller.dart';
+
+/// Direct ownership supports Navigator routes without global Get registrations.
+abstract final class OrdersBinding {
+  static OrdersController create(
+    OrdersRepository repository,
+    String accountId,
+  ) {
+    final controller = OrdersController(repository, accountId);
+    controller.onStart();
+    return controller;
+  }
+
+  static void dispose(OrdersController controller) => controller.onDelete();
+}
