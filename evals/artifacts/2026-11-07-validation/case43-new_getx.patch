+import 'package:stack_eval/features/orders/domain/orders_repository.dart';
+
+sealed class OrdersState {
+  const OrdersState(this.items);
+  final List<Order> items;
+}
+
+final class OrdersInitial extends OrdersState {
+  const OrdersInitial() : super(const []);
+}
+
+final class OrdersLoading extends OrdersState {
+  const OrdersLoading(super.items);
+}
+
+final class OrdersLoaded extends OrdersState {
+  OrdersLoaded(List<Order> items) : super(List.unmodifiable(items));
+}
+
+final class OrdersFailed extends OrdersState {
+  const OrdersFailed(this.message, super.items);
+  final String message;
+}
