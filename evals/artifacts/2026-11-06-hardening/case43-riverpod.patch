+import 'dart:async';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import '../../domain/orders_repository.dart';
+import '../providers/orders_providers.dart';
+import '../state/orders_state.dart';
+import '../state/orders_strings.dart';
+
+class OrdersNotifier extends Notifier<OrdersState> {
+  var _generation = 0;
+  var _disposed = false;
+  @override
+  OrdersState build() {
+    ref.watch(ordersRepositoryProvider);
+    ref.watch(ordersAccountProvider);
+    _disposed = false;
+    ref.onDispose(() {
+      _disposed = true;
+      _generation++;
+    });
+    scheduleMicrotask(() {
+      if (!_disposed) unawaited(load());
+    });
+    return OrdersState(loading: true);
+  }
+
+  Future<void> load() async {
+    if (_disposed) return;
+    final repository = ref.read(ordersRepositoryProvider);
+    final accountId = ref.read(ordersAccountProvider);
+    final generation = ++_generation;
+    state = OrdersState(loading: true, items: state.items);
+    OrdersResult result;
+    try {
+      result = await repository.fetch(accountId);
+    } catch (_) {
+      result = const OrdersFailure(OrdersStrings.unexpected);
+    }
+    if (_disposed || generation != _generation) return;
+    state = switch (result) {
+      OrdersSuccess(:final items) => OrdersState(items: items),
+      OrdersFailure(:final message) => OrdersState(
+        items: state.items,
+        message: message,
+      ),
+    };
+  }
+}
