+import 'package:flutter/material.dart';
+import '../state/orders_state.dart';
+import '../state/orders_strings.dart';
+
+class OrdersView extends StatelessWidget {
+  const OrdersView({required this.state, required this.retry, super.key});
+  final OrdersState state;
+  final VoidCallback retry;
+
+  @override
+  Widget build(BuildContext context) => SingleChildScrollView(
+    child: Column(
+      children: [
+        if (state.loading) const Text(OrdersStrings.loading),
+        if (state.message case final message?) Text(message),
+        if (!state.loading && state.message == null && state.items.isEmpty)
+          const Text(OrdersStrings.empty),
+        for (final order in state.items) Text(order.id),
+        TextButton(onPressed: retry, child: const Text(OrdersStrings.retry)),
+      ],
+    ),
+  );
+}
