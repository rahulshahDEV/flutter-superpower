+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import '../../domain/orders_repository.dart';
+import '../providers/orders_providers.dart';
+import '../widgets/orders_view.dart';
+
+class OrdersRoute extends StatefulWidget {
+  const OrdersRoute({
+    required this.repository,
+    required this.accountId,
+    super.key,
+  });
+  static const path = '/orders';
+  static const routeName = 'orders';
+  final OrdersRepository repository;
+  final String accountId;
+  @override
+  State<OrdersRoute> createState() => _OrdersRouteState();
+}
+
+class _OrdersRouteState extends State<OrdersRoute> {
+  Object _scopeIdentity = Object();
+  @override
+  void didUpdateWidget(covariant OrdersRoute oldWidget) {
+    super.didUpdateWidget(oldWidget);
+    if (!identical(oldWidget.repository, widget.repository) ||
+        oldWidget.accountId != widget.accountId) {
+      _scopeIdentity = Object();
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) => ProviderScope(
+    key: ObjectKey(_scopeIdentity),
+    overrides: [
+      ordersRepositoryProvider.overrideWithValue(widget.repository),
+      ordersAccountProvider.overrideWithValue(widget.accountId),
+    ],
+    child: Consumer(
+      builder: (_, ref, _) {
+        final state = ref.watch(ordersProvider);
+        return OrdersView(
+          state: state,
+          retry: ref.read(ordersProvider.notifier).load,
+        );
+      },
+    ),
+  );
+}
