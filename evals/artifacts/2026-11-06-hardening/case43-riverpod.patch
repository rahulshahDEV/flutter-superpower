+import 'dart:async';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:stack_eval/features/orders/domain/orders_repository.dart';
+import 'package:stack_eval/features/orders/presentation/pages/orders_route.dart';
+
+class PendingRequest {
+  PendingRequest(this.accountId);
+  final String accountId;
+  final result = Completer<OrdersResult>();
+}
+
+class FakeRepository implements OrdersRepository {
+  final requests = <PendingRequest>[];
+  @override
+  Future<OrdersResult> fetch(String accountId) {
+    final request = PendingRequest(accountId);
+    requests.add(request);
+    return request.result.future;
+  }
+}
+
+Widget host(FakeRepository repository, {String account = 'a'}) => MaterialApp(
+  home: Scaffold(
+    body: OrdersRoute(
+      key: const ValueKey('route'),
+      repository: repository,
+      accountId: account,
+    ),
+  ),
+);
+Future<void> flush(WidgetTester tester) async {
+  await tester.pump();
+  await tester.pump();
+}
+
+void main() {
+  testWidgets('initializes once, renders loading and successful empty', (
+    tester,
+  ) async {
+    final repository = FakeRepository();
+    await tester.pumpWidget(host(repository));
+    await flush(tester);
+    expect(find.text('Loading'), findsOneWidget);
+    expect(repository.requests.length, 1);
+    await tester.pumpWidget(host(repository));
+    await flush(tester);
+    expect(repository.requests.length, 1);
+    repository.requests.single.result.complete(OrdersSuccess([]));
+    await flush(tester);
+    expect(find.text('No orders'), findsOneWidget);
+    expect(find.text('Loading'), findsNothing);
+  });
+  testWidgets('failure retry succeeds; failed refresh retains content', (
+    tester,
+  ) async {
+    final repository = FakeRepository();
+    await tester.pumpWidget(host(repository));
+    await flush(tester);
+    repository.requests[0].result.complete(
+      const OrdersFailure('Safe unavailable'),
+    );
+    await flush(tester);
+    expect(find.text('Safe unavailable'), findsOneWidget);
+    await tester.tap(find.text('Retry'));
+    await flush(tester);
+    repository.requests[1].result.complete(
+      OrdersSuccess([const Order('order-1')]),
+    );
+    await flush(tester);
+    expect(find.text('order-1'), findsOneWidget);
+    await tester.tap(find.text('Retry'));
+    await flush(tester);
+    expect(find.text('Loading'), findsOneWidget);
+    expect(find.text('order-1'), findsOneWidget);
+    repository.requests[2].result.complete(
+      const OrdersFailure('Refresh unavailable'),
+    );
+    await flush(tester);
+    expect(find.text('order-1'), findsOneWidget);
+    expect(find.text('Refresh unavailable'), findsOneWidget);
+    expect(find.text('No orders'), findsNothing);
+  });
+  testWidgets('latest request wins when requests complete backwards', (
+    tester,
+  ) async {
+    final repository = FakeRepository();
+    await tester.pumpWidget(host(repository));
+    await flush(tester);
+    await tester.tap(find.text('Retry'));
+    await flush(tester);
+    repository.requests[1].result.complete(OrdersSuccess([const Order('new')]));
+    await flush(tester);
+    repository.requests[0].result.complete(OrdersSuccess([const Order('old')]));
+    await flush(tester);
+    expect(find.text('new'), findsOneWidget);
+    expect(find.text('old'), findsNothing);
+    expect(tester.takeException(), isNull);
+  });
+  testWidgets(
+    'same-key account replacement clears content and ignores old completion',
+    (tester) async {
+      final repository = FakeRepository();
+      await tester.pumpWidget(host(repository));
+      await flush(tester);
+      repository.requests[0].result.complete(
+        OrdersSuccess([const Order('account-a')]),
+      );
+      await flush(tester);
+      await tester.tap(find.text('Retry'));
+      await flush(tester);
+      await tester.pumpWidget(host(repository, account: 'b'));
+      await flush(tester);
+      expect(find.text('account-a'), findsNothing);
+      expect(find.text('Loading'), findsOneWidget);
+      expect(repository.requests.map((request) => request.accountId), [
+        'a',
+        'a',
+        'b',
+      ]);
+      repository.requests[2].result.complete(
+        OrdersSuccess([const Order('account-b')]),
+      );
+      await flush(tester);
+      repository.requests[1].result.complete(
+        OrdersSuccess([const Order('late-a')]),
+      );
+      await flush(tester);
+      expect(find.text('account-b'), findsOneWidget);
+      expect(find.text('late-a'), findsNothing);
+      expect(tester.takeException(), isNull);
+    },
+  );
+  testWidgets(
+    'same-key repository replacement clears content and ignores late old work',
+    (tester) async {
+      final first = FakeRepository();
+      final second = FakeRepository();
+      await tester.pumpWidget(host(first));
+      await flush(tester);
+      first.requests[0].result.complete(OrdersSuccess([const Order('first')]));
+      await flush(tester);
+      await tester.tap(find.text('Retry'));
+      await flush(tester);
+      await tester.pumpWidget(host(second));
+      await flush(tester);
+      expect(find.text('first'), findsNothing);
+      expect(second.requests.length, 1);
+      second.requests.single.result.complete(
+        OrdersSuccess([const Order('second')]),
+      );
+      await flush(tester);
+      first.requests[1].result.complete(const OrdersFailure('Old failure'));
+      await flush(tester);
+      expect(find.text('second'), findsOneWidget);
+      expect(find.text('Old failure'), findsNothing);
+      expect(tester.takeException(), isNull);
+    },
+  );
+  testWidgets(
+    'unmount and reopen starts a fresh owner; late completion is harmless',
+    (tester) async {
+      final repository = FakeRepository();
+      await tester.pumpWidget(host(repository));
+      await flush(tester);
+      await tester.pumpWidget(const SizedBox.shrink());
+      await flush(tester);
+      await tester.pumpWidget(host(repository));
+      await flush(tester);
+      expect(repository.requests.length, 2);
+      repository.requests[0].result.complete(
+        OrdersSuccess([const Order('closed')]),
+      );
+      await flush(tester);
+      expect(find.text('closed'), findsNothing);
+      repository.requests[1].result.complete(
+        OrdersSuccess([const Order('reopened')]),
+      );
+      await flush(tester);
+      expect(find.text('reopened'), findsOneWidget);
+      expect(tester.takeException(), isNull);
+    },
+  );
+  testWidgets(
+    'simultaneous routes own separate state even for the same dependencies',
+    (tester) async {
+      final repository = FakeRepository();
+      await tester.pumpWidget(
+        MaterialApp(
+          home: Scaffold(
+            body: Row(
+              children: [
+                Expanded(
+                  child: OrdersRoute(
+                    key: const ValueKey('left'),
+                    repository: repository,
+                    accountId: 'a',
+                  ),
+                ),
+                Expanded(
+                  child: OrdersRoute(
+                    key: const ValueKey('right'),
+                    repository: repository,
+                    accountId: 'a',
+                  ),
+                ),
+              ],
+            ),
+          ),
+        ),
+      );
+      await flush(tester);
+      expect(repository.requests.length, 2);
+      repository.requests[0].result.complete(
+        OrdersSuccess([const Order('left-content')]),
+      );
+      repository.requests[1].result.complete(
+        OrdersSuccess([const Order('right-content')]),
+      );
+      await flush(tester);
+      expect(find.text('left-content'), findsOneWidget);
+      expect(find.text('right-content'), findsOneWidget);
+      await tester.tap(
+        find.descendant(
+          of: find.byKey(const ValueKey('left')),
+          matching: find.text('Retry'),
+        ),
+      );
+      await flush(tester);
+      expect(repository.requests.length, 3);
+      repository.requests[2].result.complete(
+        const OrdersFailure('Left failed'),
+      );
+      await flush(tester);
+      expect(find.text('left-content'), findsOneWidget);
+      expect(find.text('right-content'), findsOneWidget);
+      expect(find.text('Left failed'), findsOneWidget);
+      expect(tester.takeException(), isNull);
+    },
+  );
+  testWidgets(
+    'unexpected exception is replaced with a safe retryable message',
+    (tester) async {
+      final repository = FakeRepository();
+      await tester.pumpWidget(host(repository));
+      await flush(tester);
+      repository.requests.single.result.completeError(
+        StateError('private transport detail'),
+      );
+      await flush(tester);
+      expect(find.text('Unable to load orders'), findsOneWidget);
+      expect(find.text('Retry'), findsOneWidget);
+      expect(tester.takeException(), isNull);
+    },
+  );
+}
