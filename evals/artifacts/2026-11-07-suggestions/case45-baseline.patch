+      await settle();
+      expect(bloc.state.items, ['content']);
+      repository.writes[0].result.complete();
+      await settle();
+      expect(repository.writes.map((call) => call.id), ['a', 'b']);
+      repository.writes[1].result.complete();
+      await settle();
