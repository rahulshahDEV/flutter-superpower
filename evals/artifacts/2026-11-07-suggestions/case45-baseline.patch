+import 'dart:async';
+
+import 'package:concurrency_eval/search_bloc.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+final class ReadCall {
+  ReadCall(this.query);
+  final String query;
+  final result = Completer<List<String>>();
+}
+
+final class WriteCall {
+  WriteCall(this.id, this.payload);
+  final String id;
+  final String payload;
+  final result = Completer<void>();
+}
+
+final class ControlledRepository implements SearchRepository {
+  final reads = <ReadCall>[];
+  final writes = <WriteCall>[];
+  final effects = <String>[];
+
+  @override
+  Future<List<String>> search(String query) {
+    final call = ReadCall(query);
+    reads.add(call);
+    return call.result.future;
+  }
+
+  @override
+  Future<void> save(String operationId, String payload) async {
+    final call = WriteCall(operationId, payload);
+    writes.add(call);
+    await call.result.future;
+    effects.add(operationId);
+  }
+}
+
+// Drain the event and future microtask queues without time-dependent sleeps.
+Future<void> settle() => Future<void>.delayed(Duration.zero);
+
+void main() {
+  late ControlledRepository repository;
+  late SearchBloc bloc;
+
+  setUp(() {
+    repository = ControlledRepository();
+    bloc = SearchBloc(repository);
+  });
+  tearDown(() async {
+    for (final call in repository.reads) {
+      if (!call.result.isCompleted) call.result.complete([]);
+    }
+    for (final call in repository.writes) {
+      if (!call.result.isCompleted) call.result.complete();
+    }
+    await settle();
+    if (!bloc.isClosed) await bloc.close();
+  });
+
+  test('refresh supersedes changed read and keeps its query', () async {
+    bloc.add(const SearchChanged('selected'));
+    await settle();
+    bloc.add(const SearchRefreshed());
+    await settle();
+    expect(repository.reads.map((call) => call.query), [
+      'selected',
+      'selected',
+    ]);
+    repository.reads[1].result.complete(['fresh']);
+    await settle();
+    repository.reads[0].result.complete(['stale']);
+    await settle();
+    expect(bloc.state.query, 'selected');
+    expect(bloc.state.items, ['fresh']);
+    expect(bloc.state.loading, isFalse);
+  });
+
+  test(
+    'changed read supersedes refresh failure and preserves save feedback',
+    () async {
+      bloc.add(const SearchRefreshed());
+      await settle();
+      bloc.add(const SearchChanged('new'));
+      await settle();
+      repository.reads[1].result.complete(['new']);
+      await settle();
+      repository.reads[0].result.completeError(StateError('stale'));
+      await settle();
+      expect(bloc.state.query, 'new');
+      expect(bloc.state.items, ['new']);
+      expect(bloc.state.readError, isNull);
+    },
+  );
+
+  test(
+    'current failure retains content and stale success cannot clear it',
+    () async {
+      bloc.add(const SearchChanged('seed'));
+      await settle();
+      repository.reads[0].result.complete(['useful']);
+      await settle();
+      bloc.add(const SearchChanged('old'));
+      await settle();
+      bloc.add(const SearchRefreshed());
+      await settle();
+      repository.reads[2].result.completeError(StateError('offline'));
+      await settle();
+      expect(bloc.state.items, ['useful']);
+      expect(bloc.state.readError, contains('offline'));
+      expect(bloc.state.loading, isFalse);
+      repository.reads[1].result.complete(['obsolete']);
+      await settle();
+      expect(bloc.state.items, ['useful']);
+      expect(bloc.state.readError, contains('offline'));
+    },
+  );
