+import 'dart:async';
+
+import 'package:concurrency_eval/search_bloc.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+final class ReadCall {
+  ReadCall(this.query);
+  final String query;
+  final result = Completer<List<String>>();
+}
+
+final class SaveCall {
+  SaveCall(this.id, this.payload);
+  final String id;
+  final String payload;
+  final result = Completer<void>();
+}
+
+final class ControlledRepository implements SearchRepository {
+  final reads = <ReadCall>[];
+  final writes = <SaveCall>[];
+  final effects = <String>[];
+
+  @override
+  Future<List<String>> search(String query) {
+    final call = ReadCall(query);
+    reads.add(call);
+    return call.result.future;
+  }
+
+  @override
+  Future<void> save(String operationId, String payload) async {
+    final call = SaveCall(operationId, payload);
+    writes.add(call);
+    await call.result.future;
+    effects.add(operationId);
+  }
+}
+
+// An event-loop fence lets Bloc consume already-submitted events; repository work
+// remains explicitly controlled by completers, with no elapsed-time assumptions.
+Future<void> dispatchEvents() => Future<void>(() {});
+
+void main() {
+  test(
+    'refresh owns the result even when the previous search finishes last',
+    () async {
+      final repository = ControlledRepository();
+      final bloc = SearchBloc(repository);
+      addTearDown(bloc.close);
+      bloc.add(const SearchChanged('chosen'));
+      await dispatchEvents();
+      bloc.add(const SearchRefreshed());
+      await dispatchEvents();
+      expect(repository.reads.map((call) => call.query), ['chosen', 'chosen']);
+      repository.reads[1].result.complete(['fresh']);
+      await dispatchEvents();
+      expect(bloc.state.items, ['fresh']);
+      repository.reads[0].result.complete(['stale']);
+      await dispatchEvents();
+      expect(bloc.state.items, ['fresh']);
+      expect(bloc.state.query, 'chosen');
+      expect(bloc.state.loading, isFalse);
+    },
+  );
+
+  test('new query owns loading and ignores stale refresh failure', () async {
+    final repository = ControlledRepository();
+    final bloc = SearchBloc(repository);
+    addTearDown(bloc.close);
+    bloc.add(const SearchChanged('old'));
+    await dispatchEvents();
+    repository.reads[0].result.complete(['useful']);
+    await dispatchEvents();
+    bloc.add(const SearchRefreshed());
+    await dispatchEvents();
+    bloc.add(const SearchChanged('new'));
+    await dispatchEvents();
+    repository.reads[1].result.completeError(Exception('stale failure'));
+    await dispatchEvents();
+    expect(bloc.state.query, 'new');
+    expect(bloc.state.loading, isTrue);
+    expect(bloc.state.readError, isNull);
+    expect(bloc.state.items, ['useful']);
+    repository.reads[2].result.complete(['new result']);
+    await dispatchEvents();
+    expect(bloc.state.items, ['new result']);
+    expect(bloc.state.loading, isFalse);
+  });
+
+  test('latest failure retains content and rejects an older success', () async {
+    final repository = ControlledRepository();
+    final bloc = SearchBloc(repository);
+    addTearDown(bloc.close);
+    bloc.add(const SearchChanged('base'));
+    await dispatchEvents();
+    repository.reads[0].result.complete(['retained']);
+    await dispatchEvents();
+    bloc.add(const SearchChanged('obsolete'));
+    await dispatchEvents();
+    bloc.add(const SearchChanged('latest'));
+    await dispatchEvents();
+    repository.reads[2].result.completeError(Exception('latest failure'));
+    await dispatchEvents();
+    expect(bloc.state.query, 'latest');
+    expect(bloc.state.items, ['retained']);
+    expect(bloc.state.loading, isFalse);
+    final failure = bloc.state.readError;
+    expect(failure, isNotNull);
+    repository.reads[1].result.complete(['obsolete']);
+    await dispatchEvents();
+    expect(bloc.state.query, 'latest');
+    expect(bloc.state.items, ['retained']);
+    expect(bloc.state.readError, failure);
+    bloc.add(const SearchRefreshed());
+    await dispatchEvents();
+    expect(repository.reads.last.query, 'latest');
+    expect(bloc.state.readError, isNull);
+    repository.reads.last.result.complete([]);
+    await dispatchEvents();
+    expect(bloc.state.items, isEmpty);
+  });
+
+  test(
+    'distinct writes are FIFO and pending/successful duplicates have one effect',
+    () async {
+      final repository = ControlledRepository();
+      final bloc = SearchBloc(repository);
+      addTearDown(bloc.close);
+      bloc
+        ..add(const SaveRequested('a', 'first'))
+        ..add(const SaveRequested('a', 'first'))
+        ..add(const SaveRequested('b', 'second'))
+        ..add(const SaveRequested('b', 'second'))
+        ..add(const SaveRequested('c', 'third'));
+      await dispatchEvents();
+      expect(repository.writes.map((call) => call.id), ['a']);
+      repository.writes[0].result.complete();
+      await dispatchEvents();
+      expect(repository.writes.map((call) => call.id), ['a', 'b']);
+      repository.writes[1].result.complete();
+      await dispatchEvents();
+      expect(repository.writes.map((call) => call.id), ['a', 'b', 'c']);
+      repository.writes[2].result.complete();
+      await dispatchEvents();
+      bloc
+        ..add(const SaveRequested('a', 'first'))
+        ..add(const SaveRequested('b', 'second'));
+      await dispatchEvents();
+      expect(repository.effects, ['a', 'b', 'c']);
+      expect(repository.writes.map((call) => call.payload), [
+        'first',
+        'second',
+        'third',
+      ]);
+      expect(bloc.state.savedIds, ['a', 'b', 'c']);
+    },
+  );
+
+  test(
+    'failed write advances queue, pending duplicate is ignored, explicit retry works',
+    () async {
+      final repository = ControlledRepository();
+      final bloc = SearchBloc(repository);
+      addTearDown(bloc.close);
+      bloc
+        ..add(const SaveRequested('a', 'first'))
+        ..add(const SaveRequested('a', 'first'))
+        ..add(const SaveRequested('b', 'second'));
+      await dispatchEvents();
+      repository.writes[0].result.completeError(Exception('save failed'));
+      await dispatchEvents();
+      expect(bloc.state.saveError, isNotNull);
+      expect(bloc.state.savedIds, isEmpty);
+      expect(repository.writes.map((call) => call.id), ['a', 'b']);
+      bloc.add(const SaveRequested('a', 'first'));
+      await dispatchEvents();
+      expect(repository.writes.length, 2);
+      repository.writes[1].result.complete();
+      await dispatchEvents();
+      expect(repository.writes.map((call) => call.id), ['a', 'b', 'a']);
+      repository.writes[2].result.complete();
+      await dispatchEvents();
+      expect(repository.effects, ['b', 'a']);
+      expect(bloc.state.savedIds, ['b', 'a']);
+      expect(bloc.state.saveError, isNull);
+    },
+  );
+
+  test(
+    'payload conflict fails safely while pending, failed and successful',
+    () async {
+      final repository = ControlledRepository();
+      final bloc = SearchBloc(repository);
+      addTearDown(bloc.close);
+      bloc.add(const SaveRequested('id', 'original'));
+      await dispatchEvents();
+      bloc.add(const SaveRequested('id', 'conflicting'));
+      await dispatchEvents();
+      expect(bloc.state.saveError, contains('another payload'));
+      expect(repository.writes.length, 1);
+      repository.writes[0].result.completeError(Exception('failure'));
+      await dispatchEvents();
+      bloc.add(const SaveRequested('id', 'conflicting'));
+      await dispatchEvents();
+      expect(bloc.state.saveError, contains('another payload'));
+      expect(repository.writes.length, 1);
+      bloc.add(const SaveRequested('id', 'original'));
+      await dispatchEvents();
+      expect(repository.writes.length, 2);
+      repository.writes[1].result.complete();
+      await dispatchEvents();
+      bloc.add(const SaveRequested('id', 'conflicting'));
+      await dispatchEvents();
+      expect(bloc.state.saveError, contains('another payload'));
+      expect(repository.writes.length, 2);
+      expect(repository.effects, ['id']);
+      expect(bloc.state.savedIds, ['id']);
+    },
+  );
+
+  test(
+    'reads and writes overlap with independent feedback and no lost state',
+    () async {
+      final repository = ControlledRepository();
+      final bloc = SearchBloc(repository);
+      addTearDown(bloc.close);
+      bloc
+        ..add(const SearchChanged('selected'))
+        ..add(const SaveRequested('a', 'first'))
+        ..add(const SaveRequested('b', 'second'));
+      await dispatchEvents();
+      expect(repository.reads.length, 1);
+      expect(repository.writes.length, 1);
+      repository.writes[0].result.completeError(Exception('write failed'));
+      await dispatchEvents();
+      final saveError = bloc.state.saveError;
+      expect(saveError, isNotNull);
+      expect(bloc.state.loading, isTrue);
+      bloc.add(const SearchRefreshed());
+      await dispatchEvents();
+      expect(bloc.state.saveError, saveError);
+      expect(repository.writes.map((call) => call.id), ['a', 'b']);
+      repository.reads[1].result.completeError(Exception('read failed'));
+      await dispatchEvents();
+      final readError = bloc.state.readError;
+      expect(readError, isNotNull);
+      expect(bloc.state.saveError, saveError);
+      repository.writes[1].result.complete();
+      await dispatchEvents();
+      expect(bloc.state.savedIds, ['b']);
+      expect(bloc.state.readError, readError);
+      repository.reads[0].result.complete(['obsolete']);
+      await dispatchEvents();
+      expect(bloc.state.readError, readError);
+      bloc.add(const SearchRefreshed());
+      await dispatchEvents();
+      repository.reads[2].result.complete(['current']);
+      await dispatchEvents();
+      expect(bloc.state.savedIds, ['b']);
+      expect(bloc.state.items, ['current']);
+      expect(bloc.state.readError, isNull);
+    },
+  );
+
+  test(
+    'close suppresses late read states and finishes accepted queued writes',
+    () async {
+      final repository = ControlledRepository();
+      final bloc = SearchBloc(repository);
+      final states = <SearchState>[];
+      final subscription = bloc.stream.listen(states.add);
+      addTearDown(subscription.cancel);
+      bloc
+        ..add(const SearchChanged('query'))
+        ..add(const SaveRequested('a', 'first'))
+        ..add(const SaveRequested('b', 'second'));
+      await dispatchEvents();
+      expect(repository.writes.map((call) => call.id), ['a']);
+      await bloc.close();
+      final stateCount = states.length;
+      repository.reads[0].result.completeError(Exception('late read failure'));
+      repository.writes[0].result.completeError(
+        Exception('late write failure'),
+      );
+      await dispatchEvents();
+      expect(repository.writes.map((call) => call.id), ['a', 'b']);
+      repository.writes[1].result.complete();
+      await dispatchEvents();
+      expect(repository.effects, ['b']);
+      expect(states.length, stateCount);
+      expect(bloc.isClosed, isTrue);
+    },
+  );
+}
