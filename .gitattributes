# Normalize line endings; shell scripts must stay LF to run everywhere.
* text=auto eol=lf

*.sh text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.dart text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary

# Unified patches require single-space blank context lines; retain replayable syntax.
evals/artifacts/**/*.patch whitespace=-blank-at-eol
